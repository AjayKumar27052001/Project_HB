# Local MongoDB example. Use synthetic demo data only.
MONGODB_URI=
MONGODB_DATABASE=juniper_hotels_demo

# Server-only Google AI Studio key; never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=

# Shared only between the booking backend and the separate AI service; use a random 32+ character value.
AI_SERVICE_TOKEN=67d5f5c48791b5d0acb8f6e8148f281ac1f3e3d9f24fcb9cd9361ca441322419

# Base URL for assistant internal REST endpoints (defaults to http://localhost:3000)
# Set to remote Java or microservice URL when backend is decoupled.
INTERNAL_API_BASE_URL=http://localhost:3000
